{
  "compilerOptions": {
    "lib": ["ES2022", "dom"],
    "module": "ESNext",
    "target": "ES2022",
    "jsx": "react",
    "strict": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["src"]
}
